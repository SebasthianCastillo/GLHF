{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "lib": ["ES2015", "DOM"],
    "paths": {
      "@/*": ["./*"]
    },
    "ignoreDeprecations": "6.0",
    "types": ["nativewind/types", "jest", "@types/react"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind.d.ts",
    "api/server.mjs",
    "api/model/Producto.js",
    "api/model/ProductDetail.js",
    "api/model/Category.js",
    "api/middleware/auth.js"
  ]
}
